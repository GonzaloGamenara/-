# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # la "anon" / "publishable" key (es pública, la seguridad la da RLS)

# Asesor (opcional): Claude con tus datos. Solo en el servidor; nunca con prefijo NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...           # console.anthropic.com → API Keys (se cobra por uso)
ASESOR_EMAILS=tu@email.com             # emails que pueden usar el asesor, separados por coma
